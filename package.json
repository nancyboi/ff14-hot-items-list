{
  "name": "ff14-hot-items-list",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Finds FFXIV market board items with unusually high recent sale volume and price on a given world, and ranks them by how easy they are to source (gather/vendor vs. multi-step crafting).",
  "scripts": {
    "build:sourcing": "node node_modules/tsx/dist/cli.mjs src/sourcing/buildDataset.ts",
    "generate": "node node_modules/tsx/dist/cli.mjs src/generate.ts",
    "serve": "node node_modules/tsx/dist/cli.mjs src/server.ts",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
