# Optional: only needed for `npm run generate -- --ai-blurbs`
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: your current DoL/DoH job levels, used to gate hot-items results to what you can
# actually acquire. JSON object keyed by job name; a job left out means level 0/can't use.
# Defaults to Miner 50, Weaver 45, Botanist 0, Fisher 0 if unset.
PLAYER_LEVELS={"Miner":50,"Weaver":45,"Botanist":0,"Fisher":0}
